[Unit]
Description=Encrypted private off-host Voxa database backup
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/voxa

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/voxa/current
Environment=AWS_PROFILE=voxa-backup
Environment=AWS_SHARED_CREDENTIALS_FILE=/etc/voxa/backup-credentials
Environment=AWS_CONFIG_FILE=/etc/voxa/aws-config
Environment=AWS_EC2_METADATA_DISABLED=true
ExecStart=/usr/bin/python3 /opt/voxa/current/infrastructure/bin/voxa-ops.py backup --execute
UMask=0077
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/voxa/backups
TimeoutStartSec=900
# A failed upload fails this unit. Connect OnFailure to an approved alert mechanism.
