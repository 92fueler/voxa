[Unit]
Description=Voxa reviewed release
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/voxa

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/voxa/current
ExecStartPre=/usr/bin/python3 /opt/voxa/current/infrastructure/bin/voxa-ops.py storage-check
ExecStart=/usr/bin/python3 /opt/voxa/current/infrastructure/bin/voxa-ops.py deploy --execute
# Do not stop active calls on unit stop; maintenance is an explicit operator action.
UMask=0077
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
