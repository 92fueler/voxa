# Docker Compose only. Native `make dev` uses backend/.env instead.
# Copy to .env, chmod 600 .env, and keep it out of Git, logs and support bundles.
# Generate each password independently: python -c "import secrets; print(secrets.token_hex(32))"
# Use hexadecimal passwords here so the application database URL needs no escaping.
POSTGRES_PASSWORD=
VOXA_DB_PASSWORD=

# Never expose this key through a VITE_ variable or any client build.
OPENAI_API_KEY=
REALTIME_MODEL=gpt-realtime-2.1
SUMMARY_MODEL=gpt-5.6-terra
SESSION_MAX_SECONDS=2700

# Required only by compose.production.yaml. No trailing slash.
# The hostname must have a DNS A record pointing to the reviewed server's static IP.
VOXA_PUBLIC_ORIGIN=https://voxa.example.com
ACME_EMAIL=
VOXA_AUTH_USERNAME=
# At least 32 characters; independent from database passwords.
VOXA_AUTH_PASSWORD=
