# Server only. Never prefix this key with VITE_ or commit your .env file.
OPENAI_API_KEY=
# Keep the full model as the initial quality reference.
REALTIME_MODEL=gpt-realtime-2.1
# Browser session timeout (seconds, 30–2700). Default: 45 minutes.
SESSION_MAX_SECONDS=2700
# Provider adapters (OpenAI is implemented; unknown names fail at startup).
VOICE_PROVIDER=openai
SUMMARY_PROVIDER=openai
SUMMARY_MODEL=gpt-5.6-terra
# Optional local BrainShuffle origin. Empty means no connection or automatic sync.
BRAINSHUFFLE_URL=
# Optional archive location; leave unset to reuse data/conversations.sqlite.
# VOXA_DATABASE_PATH=data/conversations.sqlite
