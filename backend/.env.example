# Server only. Never prefix this key with VITE_ or commit your .env file.
OPENAI_API_KEY=
# Keep the full model as the initial quality reference.
REALTIME_MODEL=gpt-realtime-2.1
# Browser session timeout (seconds, 30–2700). Default: 45 minutes.
SESSION_MAX_SECONDS=2700
# Provider adapters (OpenAI is implemented; unknown names fail at startup).
VOICE_PROVIDER=openai
SUMMARY_PROVIDER=openai
SUMMARY_MODEL=gpt-5.6-terra
# Optional local BrainShuffle origin. Empty means no connection or automatic sync.
BRAINSHUFFLE_URL=
# Optional archive location; leave unset to reuse data/conversations.sqlite.
# VOXA_DATABASE_PATH=data/conversations.sqlite

# Default is local: loopback-only 4318 API, exact local 4317 browser origins, SQLite.
# local-container explicitly enables container binding. Publish only to 127.0.0.1.
# production requires all settings below and a same-origin HTTPS reverse proxy.
VOXA_ENV=local
# PostgreSQL is optional locally, required in production. Never commit a real DSN.
# DATABASE_URL=postgresql://voxa:CHANGE_ME@db:5432/voxa
# Exact public HTTPS origin; no trailing slash, path, query, or default :443 port.
# VOXA_PUBLIC_ORIGIN=https://voice.your-domain.com
# Single-user HTTP Basic auth, server only. Never use VITE_/EXPO_PUBLIC_ variables.
# Set a unique username and a generated 32–256 character printable ASCII password
# with no spaces and at least 12 distinct characters. Do not reuse provider keys.
# VOXA_AUTH_USERNAME=
# VOXA_AUTH_PASSWORD=
